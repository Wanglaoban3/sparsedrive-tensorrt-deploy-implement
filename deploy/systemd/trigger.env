# /etc/sp/trigger.env — sp_trigger 实例配置 (M9a).
# 规则插件目录 /usr/local/share/sp/rules: 落一个 .so + thr.conf 一段 = 加规则.
SP_TRIG_RING=m3
SP_TRIG_HZ=10
SP_TRIG_MANIFEST=/opt/m0/trt-dev/nv12_r0/manifest.jsonl
SP_TRIG_RULES_DIR=/usr/local/share/sp/rules
SP_TRIG_THR=/etc/sp/thr.conf
SP_TRIG_OUT=/var/lib/sp/trigger
SP_TRIG_CTX_DUMP=0
