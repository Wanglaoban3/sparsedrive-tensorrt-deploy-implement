# /etc/sp/m3.env — SparseDrive 实例配置 (M9 多模型扩展点: 加模型=加 env 文件+unit)
# --loop --frames N: 常驻模式必需 — 节点默认把帧数钳到 manifest 长度(81)后
# 以 rc0 退出, systemd 会视为成功而停机; 显式大帧数 + loop 回绕才适合常驻。
# --no-dump: dump 默认开(门禁用), 常驻落盘 ~7.3MB/帧 会写满 /opt/m0, 必须关。
# 不带 --img-from: 那是隔离对拍模式; 常驻走真实管线(消费信箱槽位 NV12)。
# --selftest: 每次 start 跑帧0金标容差自检 (B2), 失败→SELFTEST_FAIL 心跳
# 不发有效结果; 金标在 /opt/m0/trt-dev/golden/m3 (指纹=引擎/插件 md5)。
SP_RING=m3
SP_W=1600
SP_H=900
SP_FPS=5
SP_MANIFEST=/opt/m0/trt-dev/nv12_r0/manifest.jsonl
SP_ROOT=/opt/m0/trt-dev/nv12_r0
SP_MODELS_DIR=/opt/m0/trt-dev/models
SP_PLUGIN=/usr/local/lib/libdfaplug_v8.so
SP_OUT=/var/lib/sp/m3
SP_NODE_ARGS=--warmup 2 --graph --selftest --loop --frames 1000000 --no-dump

